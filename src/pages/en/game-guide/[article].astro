---
import GameGuideArticlePage from "../../../layouts/subpages/GameGuideArticlePage.astro";
import { siteContent } from "../../../i18n/content";

export function getStaticPaths() {
  return siteContent.en.gameGuide.articles.map((article) => ({
    params: { article: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
---

<GameGuideArticlePage locale="en" pageContent={siteContent.en} article={article} />
