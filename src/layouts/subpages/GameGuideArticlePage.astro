---
import {
  gameGuideArticlePath,
  pageRoutes,
  type GameGuideArticle,
  type Locale,
  type SiteContent,
} from "../../i18n/content";
import SubPage from "../SubPage.astro";

interface Props {
  pageContent: SiteContent;
  locale: Locale;
  article: GameGuideArticle;
}

const { pageContent, locale, article } = Astro.props;
const basePath = import.meta.env.BASE_URL;
const withBasePath = (path: string) =>
  `${basePath.replace(/\/?$/, "/")}${path.replace(/^\//, "")}`;
const currentPath = gameGuideArticlePath(locale, article.slug);
const localizedPaths = {
  "zh-Hans": gameGuideArticlePath("zh-Hans", article.slug),
  en: gameGuideArticlePath("en", article.slug),
};
const sectionId = (index: number) => `guide-section-${index + 1}`;
---

<SubPage
  locale={locale}
  currentPage="gameGuide"
  pageContent={pageContent}
  pageIntro={{ kicker: article.kicker, title: article.title, body: article.body }}
  currentPath={currentPath}
  localizedPaths={localizedPaths}
>
  <section class="guide-article" aria-labelledby="guide-article-title">
    <div class="section-inner guide-article-grid">
      <aside class="guide-article-rail">
        <a class="system-back-link" href={withBasePath(pageRoutes[locale].gameGuide)}>
          {pageContent.gameGuide.articleDetail.backLabel}
        </a>
        <p class="guide-article-category">{article.category}</p>
        <h2 id="guide-article-title">{pageContent.gameGuide.articleDetail.contentsLabel}</h2>
        <ol>
          {article.sections.map((section, index) => (
            <li>
              <a href={`#${sectionId(index)}`}>
                <span>{String(index + 1).padStart(2, "0")}</span>
                {section.title}
              </a>
            </li>
          ))}
        </ol>
      </aside>

      <article class="guide-article-body">
        <p class="guide-article-summary">{article.summary}</p>
        {article.sections.map((section, sectionIndex) => (
          <section
            id={sectionId(sectionIndex)}
            class:list={["guide-section", `guide-section-${section.layout}`]}
          >
            <div class="guide-section-heading">
              <span>{String(sectionIndex + 1).padStart(2, "0")}</span>
              <div>
                <p class="kicker">{section.kicker}</p>
                <h2>{section.title}</h2>
                <p>{section.body}</p>
              </div>
            </div>
            <div class="guide-section-items">
              {section.items.map((item, itemIndex) => (
                <div class="guide-section-item">
                  {section.layout === "sequence" && (
                    <span class="guide-item-index">
                      {String(itemIndex + 1).padStart(2, "0")}
                    </span>
                  )}
                  <h3>{item.label}</h3>
                  <p>{item.text}</p>
                </div>
              ))}
            </div>
            {section.note && <p class="guide-section-note">{section.note}</p>}
          </section>
        ))}

        <footer class="guide-article-closing">
          <p class="kicker">{pageContent.gameGuide.articleDetail.closingLabel}</p>
          <p>{article.closing}</p>
        </footer>
      </article>
    </div>
  </section>
</SubPage>
